# =============================================================================
# SecrétariatPro — variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env` et renseignez les valeurs.
# `.env` est ignoré par git : n'y mettez jamais de secret dans un commit.

# --- Supabase (obligatoire) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : contourne RLS. Uniquement côté serveur, jamais exposée.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secret applicatif (obligatoire en production) ---------------------------
# Poivre des empreintes OTP et clé HMAC du cookie de défi de connexion.
# Générez-le avec :  openssl rand -base64 48
# 32 caractères minimum. Le changer invalide les codes et défis en cours.
AUTH_SECRET=

# --- URL canonique -----------------------------------------------------------
# Sert au SEO (canonical, sitemap), aux liens des emails et au contrôle CSRF.
# Sur Vercel, résolue automatiquement si absente.
NEXT_PUBLIC_SITE_URL=https://exemple.com
# Origines supplémentaires autorisées pour les mutations, séparées par une virgule.
ADDITIONAL_ALLOWED_ORIGINS=

# --- Cloudflare Turnstile (vérification humaine) -----------------------------
# À créer sur https://dash.cloudflare.com/?to=/:account/turnstile → « Add widget ».
# Mode « Managed », domaines = votre domaine + localhost.
# Laissées vides, les clés de TEST de Cloudflare sont utilisées : le widget
# valide toujours. Suffisant en local, INSUFFISANT en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Envoi d'emails (obligatoire : codes OTP) --------------------------------
# Trois voies possibles, par ordre de priorite : BREVO_API_KEY, puis
# RESEND_API_KEY, puis SMTP. Aucun changement de code pour basculer.
#
# ATTENTION - ce qui determine le classement en indesirable n'est PAS le
# fournisseur, mais l'alignement DMARC : l'adresse affichee dans « De : » doit
# etre sur un domaine dont vous controlez le DNS, et que le fournisseur signe
# en DKIM. Envoyer via Brevo « de la part de » une adresse @gmail.com echoue
# cet alignement et sera classe plus durement qu'un envoi direct.
# Verifiez avec :  npm run check:email

# Option A - Brevo par API HTTP (recommande sur Vercel)
# Preferable au SMTP Brevo : les cles SMTP peuvent etre restreintes a une liste
# d'IP autorisees, or les fonctions Vercel sortent par des IP dynamiques et non
# documentees. L'API HTTP n'a pas cette contrainte.
BREVO_API_KEY=

# Option B - Resend
RESEND_API_KEY=

# Option C - SMTP (Brevo, Gmail, autre)
# Brevo : SMTP_USER est l'identifiant technique affiche dans « SMTP et API »
# (ex. b315a6001@smtp-brevo.com). Ce n'est PAS une adresse d'expedition :
# MAIL_FROM devient alors obligatoire.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Adresse d'expedition. Doit etre verifiee chez le fournisseur, et sur un
# domaine a vous - ni gmail.com, ni *.vercel.app (DNS non modifiable).
MAIL_FROM=SecretariatPro <no-reply@votre-domaine.com>

# --- Limitation de débit distribuée (recommandé en production) ---------------
# Sans Upstash, le compteur est en mémoire : sur Vercel, chaque instance
# serverless repart de zéro, donc la limite ne tient pas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optionnel ---------------------------------------------------------------
# Rapprochement par IA (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Notifications push web (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Notifications ntfy pour les administrateurs
NTFY_URL=
NTFY_TOPIC=
# Supervision Sentry
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
# Analytique respectueuse de la vie privée
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Secret protégeant la route cron /api/digest
CRON_SECRET=
